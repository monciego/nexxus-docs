---
import { Badge, Icon, LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import heroImage from "../assets/hero-image.png";
import Button from "./Button.astro";

// Read hero content from the page frontmatter, same as Starlight's default hero.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

// Nav items shown in the product mockup's sidebar.
const navItems = [
    { name: "window", label: "Events", active: true },
    { name: "heart", label: "Clients" },
    { name: "star", label: "Talents" },
    { name: "document", label: "Call Sheets" },
    { name: "clock", label: "Calendar" },
];

// Dashboard stats shown in the product mockup.
const stats = [
    { label: "Upcoming events", value: "12" },
    { label: "Talent booked", value: "34" },
    { label: "Call sheets sent", value: "8" },
];

// Event rows shown in the product mockup.
const events = [
    {
        title: "Summer Music Festival",
        status: "Published",
        variant: "success",
        date: "Jul 24",
    },
    {
        title: "Brand Campaign Shoot",
        status: "Pending Review",
        variant: "note",
        date: "Aug 02",
    },
    {
        title: "Gala Dinner",
        status: "Cancelled",
        variant: "danger",
        date: "Aug 09",
    },
];
---

<div class="pb-14">
    <!-- Full-bleed background: grid + glows span the whole viewport,
       ignoring Starlight's content container. -->
    <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
    >
        <div
            class="hero-grid absolute inset-0 [mask-image:linear-gradient(to_bottom,black_45%,transparent)]"
        >
        </div>
        <div
            class="absolute top-[-16rem] left-1/2 h-[32rem] w-[46rem] -translate-x-1/2 rounded-full bg-(--sl-color-accent-low) opacity-60 blur-[110px] motion-reduce:blur-none"
        >
        </div>
        <div
            class="absolute top-[12rem] start-[-10rem] h-[24rem] w-[24rem] rounded-full bg-(--sl-color-purple-low) opacity-40 blur-[90px] motion-reduce:blur-none"
        >
        </div>
    </div>

    <!-- Headline block. -->
    <div
        class="relative mx-auto flex flex-col items-center gap-6 px-6 pt-12 sm:pt-18 pb-12 text-center"
    >
        <p
            class="m-0 hidden sm:inline-flex items-center gap-2 rounded-lg border border-(--sl-color-hairline-light) bg-(--sl-color-bg) px-[0.9rem] py-1.5 text-[10px] sm:text-xs font-semibold tracking-[0.08em] text-(--sl-color-gray-2) uppercase"
        >
            <span>Centralized Management Platform</span>
        </p>
        <h1
            id="_top"
            data-page-title
            class="m-0 max-w-3xl bg-linear-to-b from-(--sl-color-white) to-(--sl-color-accent-high) bg-clip-text [-webkit-background-clip:text] text-transparent [-webkit-text-fill-color:transparent] text-[clamp(var(--sl-text-3xl),calc(0.25rem+5vw),var(--sl-text-6xl))] leading-[1.08] font-bold tracking-[-0.03em]"
            set:html={title}
        />
        {
            tagline && (
                <p
                    class="m-0 max-w-[55ch] text-(--sl-color-gray-2) text-[clamp(var(--sl-text-base),calc(0.0625rem+2vw),var(--sl-text-xl))] leading-[1.65] pb-4"
                    set:html={tagline}
                />
            )
        }
        {
            actions.length > 0 && (
                <div class="mt-6 flex flex-wrap justify-center gap-6">
                    {actions.map(
                        ({
                            attrs: { class: className, ...attrs } = {},
                            link: href,
                            text,
                            variant,
                        }) => (
                            <Button
                                {href}
                                {variant}
                                class:list={[className]}
                                {...attrs}
                            >
                                {text}
                            </Button>
                        ),
                    )}
                </div>
            )
        }
    </div>

    <!-- Product mockup hero image -->
    <div class="relative mx-auto mt-14 px-4 sm:px-6" aria-hidden="true">
        <div
            class="mock-glow pointer-events-none absolute inset-x-6 -bottom-10 h-44"
        >
        </div>
        <div
            class="relative overflow-hidden rounded-[clamp(0.75rem,1.5vw,.02rem)] border border-(--sl-color-hairline) bg-(--sl-color-bg-nav) shadow-[0_30px_90px_-30px_rgba(0,0,0,0.5)]"
        >
            <div
                class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-(--sl-color-accent-low) to-transparent"
            >
            </div>
            <Image
                src={heroImage}
                alt="Nexxus production platform dashboard showing events, clients, talents, call sheets, and calendar modules"
                class="w-full h-auto block"
                loading="lazy"
            />
        </div>
    </div>
</div>
